SERVER_URL=https://your-host.example.com/jellyfin
API_KEY=your-api-key
# how often (in minutes) the script should run (0 = run once and exit)
RUN_INTERVAL_MINUTES=60
# poster language for btttr.cc (default: en)
POSTER_LANG=en

# threads used to check btttr.cc ETags in parallel (default: 10)
CHECK_WORKERS=10

# Container user (uid/gid) the app runs as; data/ must be writable by it
PUID=1000
PGID=1000

# REST API (continuous mode)
# API_PORT=8080
# API_TOKEN=your-api-token         # required by POST /refresh and GET /status
# API_RATE_LIMIT=5                 # max /refresh per minute per client
# API_GLOBAL_REFRESH_LIMIT=20      # max /refresh per minute globally
# API_STATUS_RATE_LIMIT=30         # max /status per minute per client
# AUTH_FAIL_LIMIT=5                # failed token attempts before lockout
# AUTH_LOCKOUT_MINUTES=10          # lockout window for failed attempts
